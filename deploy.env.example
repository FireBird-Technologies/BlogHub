# Copy this file to .env at the root of the repo on your droplet.
# Never commit the actual .env to git.
#
# IMPORTANT: DATABASE_URL must use "db" as the hostname (Docker service name),
# not "localhost". Example: postgresql+asyncpg://bloghub:ignored@db:5432/bloghub
# The password in the URL is accepted but not verified (trust auth on internal network).

# --- Backend env vars (same names as your backend/.env) ---
DATABASE_URL=postgresql+asyncpg://bloghub:any@db:5432/bloghub

GOOGLE_CLIENT_ID=your_google_oauth_client_id

FRONTEND_URL=https://bloghub.app

JWT_SECRET=your_long_random_secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_HOURS=168

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# --- Web (frontend nginx) ---
HTTP_PORT=8081
